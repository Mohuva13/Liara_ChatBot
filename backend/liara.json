{
  "port": 8000,
  "build": {
    "dockerfile": "./Dockerfile",
    "cache": true
  },
  "healthCheck": {
    "command": "CMD python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=2)\"",
    "interval": 30,
    "timeout": 5,
    "retries": 3,
    "startPeriod": 15
  }
}
