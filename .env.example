# Runtime
APP_ENV=development
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_BASE_URL=http://localhost:8000
DOCS_REPO_PATH=/home/mohuva/Desktop/hackaton/docs
DOCS_PUBLIC_BASE_URL=https://docs.liara.ir

# Model provider: keep real values in Liara secret/environment settings, never here.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_SMALL_MODEL=
LLM_LARGE_MODEL=
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Embeddings
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# State and retrieval
DATABASE_URL=
REDIS_URL=
SESSION_COOKIE_SECRET=
SESSION_TTL_SECONDS=7200
SESSION_MAX_TURNS=24
SESSION_SUMMARY_AFTER_TURNS=10

# Request and cost controls
RATE_LIMIT_ANONYMOUS_PER_MINUTE=10
RATE_LIMIT_ANONYMOUS_PER_HOUR=60
MAX_USER_INPUT_CHARS=4000
MAX_REQUEST_BYTES=65536
READINESS_TIMEOUT_SECONDS=2
MAX_CONTEXT_TOKENS=12000
MAX_OUTPUT_TOKENS_SMALL=700
MAX_OUTPUT_TOKENS_LARGE=1200

# Observability (optional exporters may remain unset locally)
OTEL_SERVICE_NAME=liara-assistant-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
