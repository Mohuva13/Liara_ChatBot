# Runtime
APP_ENV=development
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_BASE_URL=http://localhost:8000
DOCS_REPO_PATH=/home/mohuva/Desktop/hackaton/docs
DOCS_PUBLIC_BASE_URL=https://docs.liara.ir

# Model provider: keep real values in Liara secret/environment settings, never here.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.avalai.ir/v1
LLM_API_KEY=
LLM_SMALL_MODEL=gpt-5.4-mini
LLM_LARGE_MODEL=gpt-5.4
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Embeddings
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://api.avalai.ir/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# State and retrieval
DATABASE_URL=
REDIS_URL=
SESSION_COOKIE_SECRET=
SESSION_TTL_SECONDS=7200
SESSION_MAX_TURNS=24
SESSION_SUMMARY_AFTER_TURNS=10

# Request and cost controls
RATE_LIMIT_ANONYMOUS_PER_MINUTE=10
RATE_LIMIT_ANONYMOUS_PER_HOUR=60
MAX_USER_INPUT_CHARS=4000
MAX_REQUEST_BYTES=65536
READINESS_TIMEOUT_SECONDS=2
RETRIEVAL_CANDIDATE_LIMIT=30
EVIDENCE_LIMIT=6
RRF_K=60
EVIDENCE_MIN_SCORE=0.025
EVIDENCE_MIN_QUERY_COVERAGE=0.35
MAX_EVIDENCE_TOKENS=5000
MAX_CONTEXT_TOKENS=12000
MAX_OUTPUT_TOKENS_SMALL=700
MAX_OUTPUT_TOKENS_LARGE=1200

# Observability (optional exporters may remain unset locally)
OTEL_SERVICE_NAME=liara-assistant-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
